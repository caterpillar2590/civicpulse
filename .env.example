# Copy this file to .env and fill in real values. .env itself is
# gitignored - never commit real credentials.

# --- Postgres ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse
POSTGRES_DB=civicpulse

# --- Triage provider ---
# simulated: deterministic, no network, used by CI and safe for a first run
# rules: deterministic keyword classifier, no network, always available
# llm: calls Groq (needs GROQ_API_KEY below) - console.groq.com, free tier
# ollama: fully offline, needs the `ollama` container + a pulled model
TRIAGE_PROVIDER=simulated
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2:1b

# --- Frontend runtime config ---
# Leave blank to rely on nginx's built-in /api proxy (recommended).
# Set only if the frontend needs to call a backend on a different host.
API_BASE_URL=

# --- CORS (backend) ---
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Ports (dev convenience; prod maps these too but never for db/cache) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Production only: image source ---
REGISTRY=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
